<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Forum — Süt Kutusu Oyunu</title>
<style>
  :root{
    --bg:#0a0a10;
    --panel:#121218;
    --panel-2:#16161e;
    --line:#242430;
    --text:#e8e8ec;
    --text-dim:#8a8a97;
    --text-faint:#5c5c68;
    --grad-a:#22d3ee;
    --grad-b:#6d5bf5;
    --grad-c:#c084fc;
    --grad-warm-a:#f43f3f;
    --grad-warm-b:#f59e0b;
    --grad-warm-c:#84cc16;
    --danger:#f0554f;
  }
  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,Roboto,sans-serif;
    line-height:1.55;
    position:relative;
    overflow-x:hidden;
  }
  #stars{ position:fixed; inset:0; z-index:0; pointer-events:none; }
  .wrap{max-width:760px;margin:0 auto;padding:36px 20px 90px;position:relative;z-index:1;}
  .back{
    font-size:13px; text-decoration:none; color:var(--text-dim);
    display:inline-flex; align-items:center; gap:6px;
  }
  .back:hover{color:var(--text);}

  header.hero{margin:34px 0 30px;}
  h1.grad{
    font-size:clamp(30px,5.5vw,44px);
    font-weight:800;
    margin:0 0 8px;
    letter-spacing:.2px;
    background:linear-gradient(90deg, var(--grad-a), var(--grad-b) 55%, var(--grad-c));
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
  }
  .eyebrow{
    margin:0;
    font-size:12px;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:var(--text-faint);
  }
  .hero-divider{
    height:1px;
    margin:26px 0 0;
    background:linear-gradient(90deg, var(--grad-a), var(--grad-b), var(--grad-c), transparent);
    opacity:.5;
  }

  .panel{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:14px;
    padding:22px;
    margin-bottom:18px;
  }
  .panel h2{
    margin:0 0 16px;
    font-size:12px;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--text-dim);
    font-weight:700;
  }

  input[type=text], textarea{
    width:100%;
    font-family:inherit;
    font-size:14px;
    padding:11px 13px;
    border:1px solid var(--line);
    border-radius:9px;
    background:var(--panel-2);
    color:var(--text);
  }
  input[type=text]::placeholder, textarea::placeholder{color:var(--text-faint);}
  input[type=text]:focus, textarea:focus{
    outline:none; border-color:var(--grad-b);
  }
  textarea{resize:vertical;min-height:80px;}
  label{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-faint);display:block;margin-bottom:6px;}
  .field{margin-bottom:14px;}

  button{
    font-family:inherit;
    font-weight:600;
    font-size:13.5px;
    padding:10px 18px;
    background:linear-gradient(90deg, var(--grad-a), var(--grad-b));
    color:#08080c;
    border:none;
    border-radius:9px;
    cursor:pointer;
    transition:opacity .15s, transform .1s;
  }
  button:hover{opacity:.88;}
  button:active{transform:translateY(1px);}
  button:disabled{opacity:.4;cursor:not-allowed;}
  button.ghost{
    background:transparent;
    color:var(--text-dim);
    border:1px solid var(--line);
  }
  button.ghost:hover{color:var(--text); border-color:var(--text-faint); opacity:1;}
  .row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;}

  .topics{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px;}
  .topic{
    border:1px solid var(--line);
    border-radius:12px;
    background:var(--panel-2);
    padding:16px 18px;
    cursor:pointer;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:14px;
    transition:border-color .15s, background .15s;
  }
  .topic:hover{border-color:var(--grad-b); background:#181822;}
  .topic-main{min-width:0; display:flex; align-items:center; gap:12px;}
  .topic-title{font-weight:600;font-size:14.5px;color:var(--text); white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .topic-meta{font-size:12px;color:var(--text-faint); margin-top:3px;}
  .chevron{color:var(--text-faint); font-size:16px; flex-shrink:0;}

  .thread-header{display:flex;justify-content:space-between;align-items:flex-start;gap:12px; margin-bottom:6px;}
  .thread-header h2{margin:0; font-size:18px; color:var(--text); text-transform:none; letter-spacing:0; font-weight:700;}

  .post{
    border-top:1px solid var(--line);
    padding:16px 0;
    display:flex;
    gap:12px;
  }
  .post:first-child{border-top:none; padding-top:6px;}
  .post-avatar{
    width:36px; height:36px;
    border-radius:50%;
    object-fit:cover;
    flex-shrink:0;
    background:var(--panel-2);
    border:1px solid var(--line);
  }
  .post-content{min-width:0; flex:1;}
  .post-meta{font-size:12px;color:var(--text-faint);margin-bottom:6px;display:flex;gap:10px;align-items:center;}
  .post-body{white-space:pre-wrap;font-size:14px;color:var(--text);}
  .avatar-sm{
    width:28px; height:28px;
    border-radius:50%;
    object-fit:cover;
    flex-shrink:0;
    background:var(--panel-2);
    border:1px solid var(--line);
  }
  .avatar-xs{
    width:20px; height:20px;
    border-radius:50%;
    object-fit:cover;
    flex-shrink:0;
    background:var(--panel-2);
    border:1px solid var(--line);
    vertical-align:middle;
  }
  .nick-badge{
    font-weight:700;
    background:linear-gradient(90deg, var(--grad-warm-a), var(--grad-warm-b), var(--grad-warm-c));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .small-link{font-size:12px;background:none;border:none;color:var(--text-faint);text-decoration:underline;cursor:pointer;padding:0;}
  .small-link:hover{color:var(--danger);}
  .empty{color:var(--text-faint);font-size:14px;padding:26px 0;text-align:center;}
  footer{text-align:center;font-size:12px;color:var(--text-faint);margin-top:44px;}
  .hidden{display:none !important;}
  #status{font-size:13px;color:var(--text-faint);margin-bottom:14px;}
  .nick-inline{font-size:12px;color:var(--text-faint);margin:-8px 0 18px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
  .nick-inline .nick-badge{font-size:12px;}
  .nick-inline button{padding:3px 10px;font-size:11px;}
</style>
</head>
<body>
<canvas id="stars"></canvas>
<div class="wrap">
  <a class="back" href="https://sutkutusuoyunu.github.io/">← Geri</a>

  <header class="hero">
    <h1 class="grad">Forum</h1>
    <p class="eyebrow">Süt Kutusu Oyunu Serisi</p>
    <div class="hero-divider"></div>
  </header>

  <div id="status">Bağlanıyor…</div>
  <div class="nick-inline hidden" id="nick-bar"></div>

  <section id="view-list" class="hidden">
    <div class="panel" id="new-topic-panel">
      <h2>Yeni Konu Aç</h2>
      <div id="new-topic-form">
        <div class="field">
          <label for="new-title">Başlık</label>
          <input type="text" id="new-title" maxlength="120" placeholder=" ">
        </div>
        <div class="field">
          <label for="new-body">Mesaj</label>
          <textarea id="new-body" maxlength="4000" placeholder="yaz birşeyler"></textarea>
        </div>
        <button id="btn-new-topic">Konuyu Paylaş</button>
      </div>
      <p class="empty hidden" id="new-topic-locked" style="padding:6px 0;">Konu açmak için giriş yapmalısın.</p>
    </div>

    <div class="panel">
      <h2>Konular</h2>
      <ul class="topics" id="topic-list"></ul>
      <div class="empty hidden" id="topics-empty">Henüz konu yok. İlk konuyu sen aç!</div>
    </div>
  </section>

  <section id="view-thread" class="hidden">
    <button class="ghost small-link" id="btn-back-list" style="margin-bottom:14px;text-decoration:none;">← Konulara dön</button>
    <div class="panel">
      <div class="thread-header">
        <h2 id="thread-title"></h2>
      </div>
      <div id="thread-posts"></div>
    </div>
    <div class="panel" id="reply-panel">
      <h2>Yanıt Yaz</h2>
      <div id="reply-form">
        <div class="field">
          <textarea id="reply-body" maxlength="4000" placeholder="Yanıtını yaz…"></textarea>
        </div>
        <button id="btn-reply">Yanıtla</button>
      </div>
      <p class="empty hidden" id="reply-locked" style="padding:6px 0;">Yanıt yazmak için giriş yapmalısın.</p>
    </div>
  </section>

  <footer>Süt Kutusu Oyunu Forumu, tüm haklar saklı</footer>
</div>

<script>
// starfield background
(function(){
  const c = document.getElementById('stars');
  const ctx = c.getContext('2d');
  function resize(){ c.width = innerWidth; c.height = document.body.scrollHeight; }
  resize();
  window.addEventListener('resize', resize);
  const stars = Array.from({length:140}, () => ({
    x: Math.random()*c.width, y: Math.random()*c.height,
    r: Math.random()*1.4+0.3, o: Math.random()*0.6+0.2
  }));
  function draw(){
    ctx.clearRect(0,0,c.width,c.height);
    for (const s of stars){
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI*2);
      ctx.fillStyle = `rgba(255,255,255,${s.o})`;
      ctx.fill();
    }
  }
  draw();
  setInterval(()=>{ resize(); draw(); }, 4000);
})();
</script>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import {
  getAuth, onAuthStateChanged, signOut
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
import {
  getFirestore, collection, doc, addDoc, getDocs, getDoc,
  deleteDoc, query, orderBy, serverTimestamp
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

/* =========================================================
   FIREBASE CONFIG
   ========================================================= */
const firebaseConfig = {
  apiKey: "AIzaSyBafL4x-ANrbA8x9iPjIXvT57d6H0oJnuo",
  authDomain: "sutkutusuoyunu.firebaseapp.com",
  projectId: "sutkutusuoyunu",
  storageBucket: "sutkutusuoyunu.firebasestorage.app",
  messagingSenderId: "432642434528",
  appId: "1:432642434528:web:01701181fb552769cef785"
};

// Full URL to the login page.
const LOGIN_URL = 'https://sutkutusuoyunu.github.io/login/';

// Simple inline placeholder avatar (no network fetch, no external asset)
// shown whenever a user has no photoURL set.
const DEFAULT_AVATAR =
  'data:image/svg+xml;utf8,' + encodeURIComponent(`
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">
      <rect width="40" height="40" rx="20" fill="#16161e"/>
      <circle cx="20" cy="15.5" r="6.5" fill="#5c5c68"/>
      <path d="M8 34c1.5-8 8-11.5 12-11.5S30.5 26 32 34" fill="#5c5c68"/>
    </svg>`);

let app, db, auth;
let firebaseReady = false;
try {
  app = initializeApp(firebaseConfig);
  db = getFirestore(app);
  auth = getAuth(app);
  firebaseReady = true;
} catch (e) {
  console.error("Firebase init failed", e);
}

const statusEl = document.getElementById('status');
const topicsCol = () => collection(db, 'topics');
const postsCol = (topicId) => collection(db, 'topics', topicId, 'posts');

let currentUser = null;
let currentNickname = null;
let currentAvatar = null;

// small in-memory cache so we don't re-fetch the same user's profile
// (nickname/avatar) once per post/topic on a busy thread
const userProfileCache = new Map();
async function getUserProfile(uid){
  if (!uid) return { nickname: 'anonim', photoURL: null };
  if (userProfileCache.has(uid)) return userProfileCache.get(uid);
  let profile = { nickname: 'anonim', photoURL: null };
  try {
    const snap = await getDoc(doc(db, 'users', uid));
    if (snap.exists()){
      const d = snap.data();
      profile = { nickname: d.nickname || 'anonim', photoURL: d.photoURL || null };
    }
  } catch(e){
    console.warn('getUserProfile error:', e);
  }
  userProfileCache.set(uid, profile);
  return profile;
}

function escapeHtml(s){
  return (s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function timeAgo(ts){
  if (!ts) return '';
  const d = ts.toDate ? ts.toDate() : new Date(ts);
  const diff = (Date.now() - d.getTime())/1000;
  if (diff < 60) return 'az önce';
  if (diff < 3600) return Math.floor(diff/60)+' dk önce';
  if (diff < 86400) return Math.floor(diff/3600)+' sa önce';
  return d.toLocaleDateString('tr-TR');
}
function avatarSrc(url){
  return url || DEFAULT_AVATAR;
}

function renderNickBar(){
  const bar = document.getElementById('nick-bar');
  bar.classList.remove('hidden');
  if (currentUser){
    bar.innerHTML = `
      <img class="avatar-xs" src="${escapeHtml(avatarSrc(currentAvatar))}" alt="">
      Giriş yapan: <span class="nick-badge">${escapeHtml(currentNickname)}</span>
      <button class="ghost" id="btn-signout">Çıkış Yap</button>`;
    document.getElementById('btn-signout').onclick = () => signOut(auth);
  } else {
    bar.innerHTML = `Yazı yazmak için <button class="ghost" id="btn-goto-login">giriş yap</button>`;
    document.getElementById('btn-goto-login').onclick = () => {
      location.href = `${LOGIN_URL}?next=${encodeURIComponent(location.href)}`;
    };
  }
  // toggle the new-topic / reply forms based on auth state
  document.getElementById('new-topic-form').classList.toggle('hidden', !currentUser);
  document.getElementById('new-topic-locked').classList.toggle('hidden', !!currentUser);
  document.getElementById('reply-form').classList.toggle('hidden', !currentUser);
  document.getElementById('reply-locked').classList.toggle('hidden', !!currentUser);
}

let currentTopicId = null;

function showList(){
  currentTopicId = null;
  document.getElementById('view-thread').classList.add('hidden');
  document.getElementById('view-list').classList.remove('hidden');
  loadTopics();
}
function showThread(topicId, topicTitle){
  currentTopicId = topicId;
  document.getElementById('view-list').classList.add('hidden');
  document.getElementById('view-thread').classList.remove('hidden');
  document.getElementById('thread-title').textContent = topicTitle;
  loadPosts(topicId);
}

async function loadTopics(){
  const listEl = document.getElementById('topic-list');
  const emptyEl = document.getElementById('topics-empty');
  listEl.innerHTML = '<div class="empty">Yükleniyor…</div>';
  try {
    const q = query(topicsCol(), orderBy('createdAt','desc'));
    const snap = await getDocs(q);
    listEl.innerHTML = '';
    if (snap.empty){
      emptyEl.classList.remove('hidden');
      return;
    }
    emptyEl.classList.add('hidden');
    // fetch each topic starter's current avatar/nickname in parallel
    const rows = await Promise.all(snap.docs.map(async d => {
      const t = d.data();
      const profile = await getUserProfile(t.userId);
      return { id: d.id, t, profile };
    }));
    rows.forEach(({id, t, profile}) => {
      const li = document.createElement('li');
      li.className = 'topic';
      li.innerHTML = `<div class="topic-main">
          <img class="avatar-sm" src="${escapeHtml(avatarSrc(profile.photoURL))}" alt="">
          <div>
            <div class="topic-title">${escapeHtml(t.title)}</div>
            <div class="topic-meta">${escapeHtml(profile.nickname || t.nickname || 'anonim')} · ${timeAgo(t.createdAt)}</div>
          </div>
        </div>
        <div class="chevron">→</div>`;
      li.onclick = () => showThread(id, t.title);
      listEl.appendChild(li);
    });
  } catch(e){
    listEl.innerHTML = `<div class="empty">Yüklenemedi: ${escapeHtml(e.message)}</div>`;
  }
}

document.getElementById('btn-new-topic').onclick = async () => {
  if (!currentUser) return;
  const title = document.getElementById('new-title').value.trim();
  const body = document.getElementById('new-body').value.trim();
  if (!title || !body){ alert('Başlık ve mesaj gerekli.'); return; }
  try {
    const ref = await addDoc(topicsCol(), {
      title, nickname: currentNickname, userId: currentUser.uid, createdAt: serverTimestamp()
    });
    await addDoc(postsCol(ref.id), {
      body, nickname: currentNickname, userId: currentUser.uid, createdAt: serverTimestamp()
    });
    document.getElementById('new-title').value = '';
    document.getElementById('new-body').value = '';
    showThread(ref.id, title);
  } catch(e){
    alert('Konu oluşturulamadı: ' + e.message);
  }
};

async function loadPosts(topicId){
  const el = document.getElementById('thread-posts');
  el.innerHTML = '<div class="empty">Yükleniyor…</div>';
  try {
    const q = query(postsCol(topicId), orderBy('createdAt','asc'));
    const snap = await getDocs(q);
    el.innerHTML = '';
    // fetch each poster's current avatar/nickname in parallel
    const rows = await Promise.all(snap.docs.map(async d => {
      const p = d.data();
      const profile = await getUserProfile(p.userId);
      return { id: d.id, p, profile };
    }));
    rows.forEach(({id, p, profile}) => {
      const isMine = currentUser && p.userId === currentUser.uid;
      const div = document.createElement('div');
      div.className = 'post';
      div.innerHTML = `
        <img class="post-avatar" src="${escapeHtml(avatarSrc(profile.photoURL))}" alt="">
        <div class="post-content">
          <div class="post-meta">
            <span class="nick-badge">${escapeHtml(profile.nickname || p.nickname || 'anonim')}</span>
            <span>${timeAgo(p.createdAt)}</span>
            ${isMine ? `<button class="small-link" data-post="${id}">sil</button>` : ''}
          </div>
          <div class="post-body">${escapeHtml(p.body)}</div>
        </div>`;
      if (isMine){
        div.querySelector('[data-post]').onclick = () => deleteOwnPost(topicId, id);
      }
      el.appendChild(div);
    });
  } catch(e){
    el.innerHTML = `<div class="empty">Yüklenemedi: ${escapeHtml(e.message)}</div>`;
  }
}

async function deleteOwnPost(topicId, postId){
  if (!confirm('Bu mesajı silmek istediğine emin misin?')) return;
  try {
    await deleteDoc(doc(db, 'topics', topicId, 'posts', postId));
    loadPosts(topicId);
  } catch(e){
    alert('Silinemedi: ' + e.message);
  }
}

document.getElementById('btn-reply').onclick = async () => {
  if (!currentUser || !currentTopicId) return;
  const body = document.getElementById('reply-body').value.trim();
  if (!body) return;
  try {
    await addDoc(postsCol(currentTopicId), {
      body, nickname: currentNickname, userId: currentUser.uid, createdAt: serverTimestamp()
    });
    document.getElementById('reply-body').value = '';
    loadPosts(currentTopicId);
  } catch(e){
    alert('Gönderilemedi: ' + e.message);
  }
};

document.getElementById('btn-back-list').onclick = showList;

/* ---------- Auth state (read is public, posting requires login) ---------- */
if (firebaseReady){
  onAuthStateChanged(auth, async (user) => {
    if (!user){
      currentUser = null;
      currentNickname = null;
      currentAvatar = null;
      statusEl.textContent = '';
      renderNickBar();
      // only (re)load the list view if we're not mid-thread, so signing out
      // while reading a thread doesn't yank the user back to the list
      if (!currentTopicId) showList();
      else renderNickBar();
      return;
    }
    currentUser = user;
    try {
      const snap = await getDoc(doc(db, 'users', user.uid));
      const d = snap.exists() ? snap.data() : {};
      currentNickname = d.nickname || user.email;
      currentAvatar = d.photoURL || null;
      // keep the profile cache in sync with our own latest data
      userProfileCache.set(user.uid, { nickname: currentNickname, photoURL: currentAvatar });
    } catch(e){
      console.warn('Nickname load error:', e);
      currentNickname = user.email;
      currentAvatar = null;
    }
    statusEl.textContent = '';
    renderNickBar();
    if (!currentTopicId) showList();
    else loadPosts(currentTopicId); // refresh so "sil" buttons show correctly
  });
} else {
  statusEl.textContent = 'Firebase yapılandırması eksik — kurulum adımlarını takip et.';
}
</script>
</body>
</html>